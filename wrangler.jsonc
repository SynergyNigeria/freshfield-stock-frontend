{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "freshfield-stock-frontend",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "freshfield-stock-frontend"
		}
	],
	"routes": [
		{
			"pattern": "stock.freshfieldsinc.com",
			"zone_name": "freshfieldsinc.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
}